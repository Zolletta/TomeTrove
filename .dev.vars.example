# Example local environment variables for Wrangler (`npx wrangler dev`)
# Copy this file to `.dev.vars` and fill in your credentials.

ENVIRONMENT="development"
APP_URL="http://localhost:8787"

# GitHub OAuth credentials (from https://github.com/settings/developers)
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"

# 32-byte secret for HS256 JWT cookie signing (generate via: `openssl rand -hex 32`)
JWT_SECRET="your_32_byte_hex_jwt_secret"

# TiDB Cloud Serverless Connection String (from https://tidbcloud.com/ -> Connect)
DATABASE_URL="mysql://username:password@gateway-host/tometrove_staging?ssl={\"rejectUnauthorized\":true}"
